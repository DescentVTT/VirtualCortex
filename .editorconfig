# Editor defaults matching rustfmt, the spec tools and .gitattributes (ADR-0029).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,mjs,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
